# Copy to .env.local and fill in from Firebase Console > Project Settings > Your apps > Web app.
# A web app must be registered in the Firebase console (separate from the iOS app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wdwdaydreams-e4e4e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wdwdaydreams-e4e4e
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase Emulator Suite (firebase emulators:start).
# With emulators enabled, the placeholder config above is sufficient - no real keys needed.
NEXT_PUBLIC_USE_EMULATORS=true
