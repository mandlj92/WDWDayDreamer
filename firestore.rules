rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function timestampIsRecent(value) {
      return value >= request.time - duration.value(1, 'm') &&
             value <= request.time + duration.value(1, 'm');
    }

    function partnershipDocId(userA, userB) {
      return userA < userB ? userA + "_" + userB : userB + "_" + userA;
    }

    function isPartnershipMember(partnershipId) {
      let partnership = get(/databases/$(database)/documents/partnerships/$(partnershipId)).data;
      return isAuthenticated() &&
             (partnership.user1Id == request.auth.uid ||
              partnership.user2Id == request.auth.uid);
    }

    function arePartners(userA, userB) {
      return exists(/databases/$(database)/documents/partnerships/$(partnershipDocId(userA, userB)));
    }

    function validProfileVisibility(value) {
      return value in ['private', 'connectionsOnly', 'everyone'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) ||
                     (isAuthenticated() &&
                      resource.data.preferences.privacy.profileVisibility == 'everyone') ||
                     (isAuthenticated() &&
                      resource.data.preferences.privacy.profileVisibility == 'connectionsOnly' &&
                      (request.auth.uid in resource.data.connectionIds ||
                       arePartners(userId, request.auth.uid)));

      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 80 &&
        (!request.resource.data.keys().hasAny(['bio']) ||
          (request.resource.data.bio is string && request.resource.data.bio.size() <= 500)) &&
        request.resource.data.connectionIds is list &&
        request.resource.data.achievements is list &&
        validProfileVisibility(request.resource.data.preferences.privacy.profileVisibility);

      allow update: if isOwner(userId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() >= 1 &&
        request.resource.data.displayName.size() <= 80 &&
        (!request.resource.data.keys().hasAny(['bio']) ||
          (request.resource.data.bio is string && request.resource.data.bio.size() <= 500)) &&
        request.resource.data.connectionIds is list &&
        request.resource.data.achievements == resource.data.achievements &&
        validProfileVisibility(request.resource.data.preferences.privacy.profileVisibility);

      allow delete: if isOwner(userId);

      match /private/{document} {
        allow read, write: if isOwner(userId);
      }

      match /sessions/{sessionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.keys().hasAll([
            'deviceId', 'deviceName', 'deviceModel', 'osVersion',
            'appVersion', 'lastActiveAt', 'createdAt', 'isActive'
          ]) &&
          request.resource.data.deviceId is string &&
          request.resource.data.deviceName is string &&
          request.resource.data.deviceModel is string &&
          request.resource.data.osVersion is string &&
          request.resource.data.appVersion is string &&
          request.resource.data.isActive is bool &&
          timestampIsRecent(request.resource.data.createdAt) &&
          timestampIsRecent(request.resource.data.lastActiveAt);

        allow update: if isOwner(userId) &&
          request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.lastActiveAt >= resource.data.lastActiveAt &&
          timestampIsRecent(request.resource.data.lastActiveAt);

        allow delete: if isOwner(userId);
      }

      match /blockedUsers/{blockedUserId} {
        allow read, write: if isOwner(userId) && blockedUserId != userId;
      }
    }

    match /partnerships/{partnershipId} {
      allow read: if isAuthenticated() &&
        (resource.data.user1Id == request.auth.uid ||
         resource.data.user2Id == request.auth.uid);

      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll([
          'id', 'user1Id', 'user2Id', 'createdAt',
          'enabledCategories', 'nextAuthorId'
        ]) &&
        partnershipId == partnershipDocId(
          request.resource.data.user1Id,
          request.resource.data.user2Id
        ) &&
        request.resource.data.id == partnershipId &&
        request.resource.data.user1Id != request.resource.data.user2Id &&
        request.resource.data.user2Id == request.auth.uid &&
        request.resource.data.nextAuthorId == request.resource.data.user1Id &&
        request.resource.data.enabledCategories is list &&
        request.resource.data.enabledCategories.size() > 0 &&
        request.resource.data.enabledCategories.size() <= 5 &&
        timestampIsRecent(request.resource.data.createdAt);

      allow update: if isAuthenticated() &&
        (resource.data.user1Id == request.auth.uid ||
         resource.data.user2Id == request.auth.uid) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.user1Id == resource.data.user1Id &&
        request.resource.data.user2Id == resource.data.user2Id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.enabledCategories is list &&
        request.resource.data.enabledCategories.size() > 0 &&
        request.resource.data.enabledCategories.size() <= 5 &&
        (!request.resource.data.keys().hasAny(['nextAuthorId']) ||
          request.resource.data.nextAuthorId in [resource.data.user1Id, resource.data.user2Id]);

      allow delete: if isAuthenticated() &&
        (resource.data.user1Id == request.auth.uid ||
         resource.data.user2Id == request.auth.uid);

      match /stories/{storyId} {
        allow read: if isPartnershipMember(partnershipId);

        allow create: if isPartnershipMember(partnershipId) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId ==
            get(/databases/$(database)/documents/partnerships/$(partnershipId)).data.nextAuthorId &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 20000;

        allow update: if isPartnershipMember(partnershipId) &&
          resource.data.authorId == request.auth.uid &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.items == resource.data.items &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 20000;

        allow delete: if isPartnershipMember(partnershipId) &&
          resource.data.authorId == request.auth.uid;
      }
    }

    match /palInvitations/{invitationId} {
      function isValidInvitationCode() {
        return invitationId.matches('^[A-Z0-9]{6}$');
      }

      allow get: if isAuthenticated() && isValidInvitationCode() &&
        (resource == null ||
         resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid ||
         (resource.data.invitationCode == invitationId &&
          resource.data.status == 'pending' &&
          resource.data.expiresAt > request.time));

      allow list: if isAuthenticated() &&
        (resource.data.fromUserId == request.auth.uid ||
         resource.data.toUserId == request.auth.uid);

      allow create: if isAuthenticated() &&
        invitationId == request.resource.data.invitationCode &&
        request.resource.data.invitationCode.matches('^[A-Z0-9]{6}$') &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.fromUserEmail == request.auth.token.email &&
        request.resource.data.keys().hasAll([
          'fromUserId', 'fromUserName', 'fromUserEmail',
          'invitationCode', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.status == 'pending' &&
        timestampIsRecent(request.resource.data.createdAt) &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      allow update: if isAuthenticated() &&
        isValidInvitationCode() &&
        resource.data.invitationCode == invitationId &&
        (
          (resource.data.fromUserId == request.auth.uid &&
           resource.data.status == 'pending' &&
           request.resource.data.status in ['declined', 'expired'] &&
           request.resource.data.fromUserId == resource.data.fromUserId &&
           request.resource.data.fromUserName == resource.data.fromUserName &&
           request.resource.data.fromUserEmail == resource.data.fromUserEmail &&
           request.resource.data.invitationCode == resource.data.invitationCode &&
           request.resource.data.createdAt == resource.data.createdAt &&
           request.resource.data.expiresAt == resource.data.expiresAt &&
           request.resource.data.toUserId == resource.data.toUserId) ||
          (resource.data.fromUserId != request.auth.uid &&
           resource.data.status == 'pending' &&
           resource.data.expiresAt > request.time &&
           (resource.data.toUserId == null || resource.data.toUserId == request.auth.uid) &&
           request.resource.data.status == 'accepted' &&
           request.resource.data.toUserId == request.auth.uid &&
           request.resource.data.fromUserId == resource.data.fromUserId &&
           request.resource.data.fromUserName == resource.data.fromUserName &&
           request.resource.data.fromUserEmail == resource.data.fromUserEmail &&
           request.resource.data.invitationCode == resource.data.invitationCode &&
           request.resource.data.createdAt == resource.data.createdAt &&
           request.resource.data.expiresAt == resource.data.expiresAt)
        );

      allow delete: if isAuthenticated() &&
        resource.data.fromUserId == request.auth.uid;
    }

    match /userStories/{userId}/{collection}/{storyId} {
      allow read, write: if isOwner(userId);
    }

    match /userSettings/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /notificationQueue/{queueId} {
      allow create: if isAuthenticated() &&
        request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'requesterId', 'targetUserId', 'type', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'requesterId', 'targetUserId', 'type', 'partnershipId',
          'storyId', 'createdAt', 'processed'
        ]) &&
        request.resource.data.targetUserId is string &&
        request.resource.data.targetUserId != request.auth.uid &&
        request.resource.data.type in ['story_completed', 'new_prompt'] &&
        request.resource.data.partnershipId is string &&
        isPartnershipMember(request.resource.data.partnershipId) &&
        request.resource.data.targetUserId in [
          get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnershipId)).data.user1Id,
          get(/databases/$(database)/documents/partnerships/$(request.resource.data.partnershipId)).data.user2Id
        ] &&
        timestampIsRecent(request.resource.data.createdAt) &&
        (!request.resource.data.keys().hasAny(['processed']) ||
          request.resource.data.processed == false);

      allow read, update, delete: if false;
    }

    match /sharedStories/{storyId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /connectionTest/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /moderationQueue/{queueId} {
      allow read, write: if false;
    }

    match /contentReports/{reportId} {
      allow create: if isAuthenticated() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reportedUserId != request.auth.uid &&
        request.resource.data.keys().hasAll([
          'reporterId', 'contentType', 'contentId',
          'reportedUserId', 'reason', 'createdAt'
        ]) &&
        request.resource.data.contentType in ['story', 'profile'] &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 1 &&
        request.resource.data.reason.size() <= 500 &&
        timestampIsRecent(request.resource.data.createdAt);

      allow read: if isAuthenticated() &&
        resource.data.reporterId == request.auth.uid;
      allow update, delete: if false;
    }

    match /securityIncidents/{incidentId} {
      allow read, write: if false;
    }

    match /contentPacks/{packId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
